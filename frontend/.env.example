# Copy this file to .env.local and fill in your values
# .env.local is gitignored by default

# FastAPI backend base URL (no trailing slash)
VITE_API_BASE_URL=http://localhost:8000

# Health polling interval in milliseconds (default: 30000)
VITE_HEALTH_POLL_INTERVAL=30000

# Lookup cache TTL in milliseconds (default: 600000 = 10 min)
VITE_LOOKUP_CACHE_TTL=600000

# Auth endpoint paths (relative to VITE_API_BASE_URL)
VITE_AUTH_LOGIN_PATH=/login
VITE_AUTH_SIGNUP_PATH=/signup

# If true, frontend falls back to localStorage auth when backend auth is unavailable
VITE_AUTH_FALLBACK_LOCAL=true
